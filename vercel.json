{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/webhooks/process.js": {
      "maxDuration": 120
    },
    "api/webhooks/process-signals.js": {
      "maxDuration": 120
    },
    "api/webhooks/recover-bookings.js": {
      "maxDuration": 120
    },
    "api/webhooks/process-leads.js": {
      "maxDuration": 120
    },
    "api/webhooks/process-tasks.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/webhooks/process-signals",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/webhooks/process",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/webhooks/recover-bookings",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/webhooks/process-leads",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/webhooks/process-tasks",
      "schedule": "* * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/linktree-mads",
      "destination": "/links?legacy_route=legacy_001&route_map_version=v1",
      "statusCode": 302
    },
    {
      "source": "/special-offer-dc",
      "destination": "/apply?legacy_route=legacy_033&route_map_version=v1",
      "statusCode": 302
    }
  ]
}
